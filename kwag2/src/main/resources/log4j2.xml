<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="kr.sy.kwag2">
  <Properties>
    <Property name="log.path">logs</Property>
    <Property name="log.pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Property>
  </Properties>

  <Appenders>
    <!-- 콘솔 출력 -->
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${log.pattern}" />
    </Console>

    <!-- 일일 롤링 파일 (전체 로그) -->
    <RollingFile name="RollingFile"
      fileName="${log.path}/kwag2.log"
      filePattern="${log.path}/kwag2-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="${log.pattern}" />
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true" />
        <SizeBasedTriggeringPolicy size="100MB" />
      </Policies>
      <DefaultRolloverStrategy max="30" />
    </RollingFile>

    <!-- 에러 로그 파일 -->
    <RollingFile name="ErrorFile"
      fileName="${log.path}/error.log"
      filePattern="${log.path}/error-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="${log.pattern}" />
      <Filters>
        <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY" />
      </Filters>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true" />
        <SizeBasedTriggeringPolicy size="100MB" />
      </Policies>
      <DefaultRolloverStrategy max="30" />
    </RollingFile>

    <!-- 애플리케이션 로그 파일 -->
    <RollingFile name="AppFile"
      fileName="${log.path}/app.log"
      filePattern="${log.path}/app-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="${log.pattern}" />
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true" />
        <SizeBasedTriggeringPolicy size="100MB" />
      </Policies>
      <DefaultRolloverStrategy max="30" />
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- 애플리케이션 로거 -->
    <Logger name="kr.sy.kwag2" level="debug" additivity="false">
      <AppenderRef ref="Console" />
      <AppenderRef ref="AppFile" />
    </Logger>

    <!-- Spring 로거 -->
    <Logger name="org.springframework" level="info" />
    <Logger name="org.springframework.web" level="info" />

    <!-- MyBatis 로거 -->
    <Logger name="org.mybatis" level="debug" />

    <!-- Root 로거 -->
    <Root level="info">
      <AppenderRef ref="Console" />
      <AppenderRef ref="RollingFile" />
      <AppenderRef ref="ErrorFile" />
    </Root>
  </Loggers>
</Configuration>